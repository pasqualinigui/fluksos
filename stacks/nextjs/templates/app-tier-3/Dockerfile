# Uses Alpine for maximum size reduction
FROM node:22-alpine AS base

# Dependency Phase
FROM base AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app
COPY package.json pnpm-lock.yaml* ./
# Activate pnpm
RUN corepack enable pnpm && pnpm i --frozen-lockfile

# Build Phase
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# Disable Next.js telemetry
ENV NEXT_TELEMETRY_DISABLED=1
RUN corepack enable pnpm && pnpm run build

# Production Phase
FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Observability variables (overridden at runtime)
ENV OTEL_SERVICE_NAME="fluksos-app"
ENV OTEL_EXPORTER_OTLP_ENDPOINT="http://alloy:4318/v1/traces"

# Setup non-root user (Enterprise Security)
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Copy public folder
COPY --from=builder /app/public ./public

# Copy generated files in standalone mode
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Run the custom server generated by standalone mode
# Requires .dockerignore to exclude node_modules and .next for optimal context
CMD ["node", "server.js"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/ || exit 1

LABEL org.opencontainers.image.title="Fluksos App (Tier 3)"
LABEL org.opencontainers.image.description="Next.js App with LGTM Observability"
LABEL org.opencontainers.image.source="https://github.com/fluksos/fluksos"
