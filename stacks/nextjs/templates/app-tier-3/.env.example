# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database
DATABASE_URL="postgres://postgres:postgres@localhost:5432/fluksos"

# Authentication (Better Auth)
BETTER_AUTH_SECRET="super-secret-key-that-is-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# Redis (Upstash) - Optional for Rate Limiting
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Observability (LGTM / Alloy)
OTEL_SERVICE_NAME="fluksos-app"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318/v1/traces"
NEXT_PUBLIC_FARO_COLLECTOR_URL="http://localhost:12347/collect"

# Continuous Profiling (Pyroscope)
PYROSCOPE_ENABLED="false"
PYROSCOPE_SERVER_ADDRESS="http://localhost:4040"
