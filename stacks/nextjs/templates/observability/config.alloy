// Grafana Alloy Configuration for Fluksos Observability Stack

logging {
  level = "info"
}

// 1. OTLP Receiver (Traces & Metrics from NodeSDK & Faro)
otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
    cors {
      allowed_origins = ["*"]
    }
  }

  output {
    traces  = [otelcol.processor.batch.default.input]
    metrics = [otelcol.processor.batch.default.input]
  }
}

// 2. Faro Receiver (Frontend RUM)
faro.receiver "default" {
  server {
    listen_address = "0.0.0.0"
    listen_port = 12347
    cors_allowed_origins = ["*"]
  }

  output {
    traces = [otelcol.processor.batch.default.input]
    logs   = [loki.process.faro_logs.receiver]
  }
}

// 3. Processors
otelcol.processor.batch "default" {
  output {
    traces  = [otelcol.exporter.otlp.tempo.input]
    metrics = [otelcol.exporter.prometheus.mimir.input]
  }
}

loki.process "faro_logs" {
  forward_to = [loki.write.loki.receiver]
  stage.json {
    expressions = {
      level = "level",
      message = "message",
    }
  }
  stage.labels {
    values = {
      level = "level",
    }
  }
}

// 4. Exporters
// Traces to Tempo
otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}

// Metrics to Prometheus
otelcol.exporter.prometheus "mimir" {
  forward_to = [prometheus.remote_write.mimir.receiver]
}

prometheus.remote_write "mimir" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

// Logs to Loki
loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// Profiling (Optional via Beyla/Pyroscope)
pyroscope.write "default" {
  endpoint {
    url = "http://pyroscope:4040"
  }
}
